{
  "name": "companion",
  "productName": "Companion",
  "version": "1.0.0",
  "description": "Turn one photo of your pet into an animated desktop companion",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "selftest": "node build.mjs && electron . --selftest",
    "icons": "node scripts/make-icon.mjs",
    "package": "node build.mjs && electron-packager . Companion --platform=win32 --arch=x64 --icon=assets/icon.ico --out=release --overwrite --asar --asar.unpack=\"**/*.node\" --ignore=\"^/(\\.selftest|release|scripts|src/dev)($|/)\" --ignore=\"^/assets/(3nbr\\.companion|poses/(3nbr|anbar|ai/src))($|/)\" --ignore=\"^/dist/[a-z]+-dev\\.js\" --ignore=\"\\.map$\""
  },
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@imgly/background-removal": "^1.7.0",
    "electron": "^45.1.0",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "^1.21.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "uiohook-napi": "^1.5.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
